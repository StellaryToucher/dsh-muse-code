{
  "name": "@stellarytoucher/dsh-muse-code",
  "version": "0.1.1-dsh021.0",
  "description": "Muse Code subagent provider for DeepSeek Harness — community fork with DSH 0.2.1+ compatibility fixes",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/main.js",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    },
    "./tool": {
      "types": "./lib/tool-platform.d.ts",
      "default": "./lib/tool-platform.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests/runtime.test.js .test-build/tests/tool.test.js .test-build/tests/policy.test.js .test-build/tests/session-env.test.js .test-build/tests/boundaries.test.js",
    "test:real": "tsc -p tsconfig.tests.json && node .test-build/tests/real-muse.js",
    "check": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@types/node": "^20.19.43",
    "typescript": "5.9.3"
  },
  "types": "./lib/main.d.ts",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <4.1.0-0 || >=4.0.5-alpha.1 <4.1.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.1.7-rc.2 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.7-rc.2 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StellaryToucher/dsh-muse-code.git"
  },
  "homepage": "https://github.com/StellaryToucher/dsh-muse-code#readme",
  "bugs": {
    "url": "https://github.com/StellaryToucher/dsh-muse-code/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "muse-code",
    "subagent",
    "cordis"
  ]
}
