+// DSH >= 0.2.1 removed `ctx.subagents.start(name, request)`. The provider object
+// itself still owns `start(request)`, so fall back to it when the service method
+// is gone (startActivation() is the new manager path, but it requires a full
+// { parent, maxDepth } control spec we do not build here).
+function startProviderRun(ctx, providerName, request) {
+    const svc = ctx.subagents;
+    if (typeof svc.start === 'function')
+        return svc.start(providerName, request);
+    const provider = svc.getProvider(providerName);
+    if (!provider)
+        throw new Error(`subagent provider "${providerName}" is not registered`);
+    return provider.start(request);
+}
